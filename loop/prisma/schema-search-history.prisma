// ------------------------------------------------------------------
// Add this model to your main prisma/schema.prisma (do not create a
// second schema file in the real project — Prisma only reads one).
// Also add the two relation lines noted below to your existing
// User and Workspace models.
// ------------------------------------------------------------------

model SearchHistory {
  id          String    @id @default(cuid())
  query       String
  filters     Json?     // stores { channel, sentiment, theme, status, dateRange } snapshot
  resultCount Int       @default(0)
  createdAt   DateTime  @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([workspaceId])
}

