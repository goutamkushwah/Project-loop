{
  "name": "loop",
  "version": "1.0.0",
  "private": true,
  "description": "LOOP — AI Customer-Feedback Intelligence Platform",
  "engines": {
    "node": ">=18.18.0"
  },
   "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "ai:verify": "tsx scripts/verify-ai.ts",
    "ai:backfill": "tsx scripts/backfill-classification.ts",
    "db:seed:classified": "npm run db:seed && npm run ai:backfill",
    "ai:backfill-embeddings": "tsx scripts/backfill-embeddings.ts",
    "db:seed:ready": "npm run db:seed:classified && npm run ai:backfill-embeddings",
    "db:verify:seed": "tsx scripts/verify-final-seed.ts",
    "db:seed:final": "npm run db:seed:ready && npm run db:verify:seed",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^7.0.1",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.0",
    "eslint-config-next": "^0.2.4",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  }
}
